{
  "manifest_version": 3,
  "name": "FormFlow - Driving Licence Assistant",
  "version": "1.0.0",
  "description": "Local assistant for Sarathi driving-licence service desk operations (Phase 7A shell).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "FormFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
