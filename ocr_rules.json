{
  "_note": "Local OCR/extraction tuning only. Deterministic rules first; no cloud, no LLM.",
  "_labels_note": "Phase 3: father_name/application_no label lists added. 'Father's Name' and the numbered field labels come from the local LL sample's printed format; application_no includes the observed OCR forms of the printed 'App.No.' label (the sample OCR produced 'AppiNo'). No real documents or values are stored here.",
  "version": "3",
  "dpi": 300,
  "lang": "eng",
  "psm": 6,
  "upscale": true,
  "upscale_min_height": 1500,
  "min_page_chars": 30,
  "binarize": false,
  "opencv": {
    "_note": "Phase 2 experiment tuning for opencv-gray/opencv-thresh variants only. Baseline ignores this block.",
    "canny_low": 50,
    "canny_high": 150,
    "min_area_ratio": 0.15,
    "max_area_ratio": 0.98,
    "epsilon_ratio": 0.02,
    "min_confidence": 0.6,
    "edge_support_min": 0.5,
    "centroid_max_offset": 0.2,
    "frame_touch_margin": 0.02,
    "deskew_max_angle_deg": 15.0,
    "clahe_clip_limit": 2.0,
    "adaptive_block_size": 51,
    "adaptive_c": 9,
    "rectify_min_dim": 200,
    "rectify_min_area_ratio": 0.1,
    "rectify_max_excluded_edge_frac": 0.02
  },
  "fields": {
    "full_name": {
      "labels": ["full name", "name of the applicant", "applicant name", "holder name", "name"],
      "max_words": 5
    },
    "father_name": {
      "labels": ["father's name", "fathers name", "father name", "name of the father", "name of father", "father's / husband's name", "father/husband name", "father / husband name"],
      "max_words": 5
    },
    "dob": {
      "labels": ["date of birth", "dob", "birth date", "born"]
    },
    "address": {
      "labels": ["permanent address", "present address", "address", "addr", "residence"],
      "max_lines": 3
    },
    "licence_no": {
      "labels": ["driving licence no", "driving license no", "licence no", "license no", "licence number", "license number", "dl no", "ll no"]
    },
    "application_no": {
      "labels": ["application number", "application no", "appi no", "appino", "app no", "appno", "app. no", "app.no", "appl no", "appln no"],
      "min_digits": 8,
      "max_digits": 20
    }
  }
}
