{
  "_note": "Local OCR/extraction tuning only. Deterministic rules first; no cloud, no LLM.",
  "_labels_note": "Phase 3: father_name/application_no label lists added. 'Father's Name' and the numbered field labels come from the local LL sample's printed format; application_no includes the observed OCR forms of the printed 'App.No.' label (the sample OCR produced 'AppiNo'). Phase 4A: 'display name' added for template-B rows (a specific name label suppresses bare 'Name' rows); 'son / wife / daughter of' and 'son / wife / daughter' added for the template-B father rows (OCR drops or fuses the 'of'); label matching treats whitespace inside multi-word labels as optional and slash spacing as optional (OCR emits 'PresentAddress' / 'Son/Wife/Daughter'). No real documents or values are stored here.",
  "version": "4",
  "dpi": 300,
  "lang": "eng",
  "psm": 6,
  "upscale": true,
  "upscale_min_height": 1500,
  "min_page_chars": 30,
  "binarize": false,
  "opencv": {
    "_note": "Phase 2 experiment tuning for opencv-gray/opencv-thresh variants only. Baseline ignores this block.",
    "canny_low": 50,
    "canny_high": 150,
    "min_area_ratio": 0.15,
    "max_area_ratio": 0.98,
    "epsilon_ratio": 0.02,
    "min_confidence": 0.6,
    "edge_support_min": 0.5,
    "centroid_max_offset": 0.2,
    "frame_touch_margin": 0.02,
    "deskew_max_angle_deg": 15.0,
    "clahe_clip_limit": 2.0,
    "adaptive_block_size": 51,
    "adaptive_c": 9,
    "rectify_min_dim": 200,
    "rectify_min_area_ratio": 0.1,
    "rectify_max_excluded_edge_frac": 0.02
  },
  "fields": {
    "full_name": {
      "labels": ["full name", "display name", "name of the applicant", "applicant name", "holder name", "name"],
      "max_words": 5
    },
    "father_name": {
      "labels": ["father's name", "fathers name", "father name", "name of the father", "name of father", "father's / husband's name", "father/husband name", "father / husband name", "son / wife / daughter of", "son / wife / daughter"],
      "max_words": 5
    },
    "dob": {
      "labels": ["date of birth", "dob", "birth date", "born", "d.o.b", "d.o.b.", "birthdate"]
    },
    "address": {
      "labels": ["permanent address", "present address", "address", "addr", "residence"],
      "max_lines": 3
    },
    "licence_no": {
      "labels": ["driving licence no", "driving license no", "licence no", "license no", "licence number", "license number", "lic no", "learning licence no", "learning license no", "learning licence number", "learning license number", "learner's licence no", "learner's license no", "learner's licence", "learner's license", "learners licence no", "learners license no", "learning licence", "learning license", "dl no", "ll no", "ll number", "licence", "license"]
    },
    "application_no": {
      "labels": ["application number", "application no", "application num", "appi no", "appino", "app no", "appno", "app number", "appnumber", "app. no", "app.no", "appl no", "appl. no", "appl.no", "appl number", "appln no", "appln number", "application ref no", "app ref no", "acknowledgement no", "ack no"],
      "min_digits": 8,
      "max_digits": 20
    }
  }
}
